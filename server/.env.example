# Required application settings
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/warrantyvault
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Optional: seed the first administrator only when both values are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email settings: choose "smtp" or "resend". Resend sends over HTTPS.
EMAIL_PROVIDER=smtp
EMAIL_FROM=

# Resend API settings. Verify the sender's domain with Resend before production use.
RESEND_API_KEY=

# Optional Resend fallback over HTTPS. Verify EMAIL_FROM with SendGrid too.
SENDGRID_API_KEY=

# SMTP settings (used when EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Daily schedule (node-cron syntax) and IANA timezone.
REMINDER_CRON=0 9 * * *
REMINDER_TIMEZONE=UTC

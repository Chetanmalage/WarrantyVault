# Required application settings
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/warrantyvault
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# SMTP settings: use credentials and a verified sender from your email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Daily schedule (node-cron syntax) and IANA timezone.
REMINDER_CRON=0 9 * * *
REMINDER_TIMEZONE=UTC

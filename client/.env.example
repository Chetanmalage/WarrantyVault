# API base URL.
# In development: leave blank to use http://localhost:5000/api.
# In production: REQUIRED when the frontend and backend are hosted separately
# (e.g. Vercel frontend + Render backend). Example:
#   VITE_API_URL=https://warrantyvault-16et.onrender.com/api
# If left blank in production, requests to /api/* will not reach the backend.
VITE_API_URL=https://warrantyvault-16et.onrender.com/api